<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>dev.ethanstokes.Macros</id>

  <name>Macros</name>
  <summary>Visually create and run keyboard and mouse macros</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>

  <developer id="dev.ethanstokes">
    <name>Ethan Stokes</name>
  </developer>

  <launchable type="desktop-id">dev.ethanstokes.Macros.desktop</launchable>

  <description>
    <p>
      Macros is a visual editor for building and running keyboard and mouse
      automation. Record input, assemble sequences of actions in an editor,
      and bind them to hotkeys to play back later.
    </p>
    <p>
      It runs on Windows, Linux, and macOS.
    </p>
  </description>

